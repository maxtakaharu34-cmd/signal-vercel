{
  "name": "fx-signal-terminal",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "npm run build:ui && next build",
    "build:ui": "node scripts/build-pages.mjs && esbuild web/app.mjs --bundle --minify --format=esm --target=es2022 --outfile=public/app.mjs",
    "dev": "npm run build:ui && next dev --hostname 127.0.0.1 --port 3110",
    "start": "next start --hostname 127.0.0.1 --port 3110"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "fflate": "0.7.5"
  }
}
